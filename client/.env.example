# Directory/URL containing model.onnx, tokenizer.json, and rl_agent_config.json.
# The client model is intentionally opt-in because it uses about 1 GB of RAM.
VITE_LAYA_MODEL_DIR=/models/laya/

# Built-in WASM assets are emitted under the Vite bundle by default.
# Override this only when serving them from another origin/CDN.
# VITE_LAYA_WASM_BASE=https://cdn.example.com/laya/wasm-pkg/
