{
  "manifest_version": 3,
  "name": "Laya Command Guard",
  "version": "0.1.0",
  "description": "Flags unsafe terminal commands on any page with the local Laya model — secrets, reverse shells, destructive ops, and OS mismatches.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Laya Command Guard"
  },
  "permissions": ["storage", "offscreen"],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": []
}
