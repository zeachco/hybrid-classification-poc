PY_DECISION_APP_NAME=py-decision
PY_DECISION_ENVIRONMENT=development
# Laya uses the English checkpoint by default. Without a local model directory,
# it downloads the checkpoint from Hugging Face on first classification.
PY_DECISION_LAYA_MODEL=english
# Leave empty to let Laya select the available device.
# PY_DECISION_LAYA_DEVICE=cpu
# Path to a local Laya model directory (for development/testing). Leave unset to download from HF.
# PY_DECISION_LAYA_MODEL_DIR=/path/to/model
